{
  "name": "belay-unix",
  "version": "1.0.10",
  "description": "支持 uni-app 和 uni-app x 的跨平台组件库，提供 107 个高质量组件，覆盖基础、表单、反馈、展示、导航等场景。",
  "main": "index.js",
  "module": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.js",
      "types": "./index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "components",
    "utils",
    "styles",
    "locales",
    "index.js",
    "index.d.ts",
    "index.ts",
    "init.uts",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "pack:dry": "npm pack --dry-run",
    "pack": "npm run pack:dry && npm pack",
    "publish:npm": "npm publish",
    "publish:public": "npm publish --access public",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major"
  },
  "keywords": [
    "ui",
    "belay-unix",
    "uni-app",
    "vue"
],
  "author": "Belay",
