<template>
	<view v-if="result" class="bl-share-poster">
		<bl-poster-painter
			:palette="result"
			width="290px"
			height="430px"
			:scale-ratio="2"
			@img-ok="handleImageReady"
			@img-err="handleError"
		></bl-poster-painter>
	</view>
</template>

<script lang="uts">
	// 海报描述类型
	type BlPosterDescription = {
		background?: string
		[key: string]: string | number | boolean | null | undefined
	}

	// 海报描述函数类型
	type BlPosterDescriptionFunction = () => Promise<BlPosterDescription> | BlPosterDescription

	// 海报绘制配置类型
	type PosterPalette = {
		width: string
		height: string
		borderRadius: string
		background: string
		views: Array<{
			type: string
			[key: string]: string | number | boolean | null | undefined
		}>
		[key: string]: string | number | boolean | Array<{ [key: string]: string | number | boolean | null | undefined }> | null | undefined
	}

	// 错误类型
	type PosterError = Error | {
		message?: string
		[key: string]: string | number | boolean | null | undefined
	}

	export default {
		name: 'BlSharePoster',
		props: {
			/**
			 * 海报描述
			 */
			value: {
				type: [Object, Function],
				required: true
			}
		},
		data() {
			return {
				result: null as PosterPalette | null,
				loading: false,
				error: null as Error | null
			}
		},
		watch: {
			value: {
				handler(newVal: BlPosterDescription | BlPosterDescriptionFunction) {
					this.loadPoster()
				},
				immediate: true
			}
		},
		methods: {
			async loadPoster(): Promise<void> {
				try {
					this.loading = true
					this.error = null
					
					let poster: BlPosterDescription
					if (typeof this.value == 'function') {
						const posterFunc = this.value as BlPosterDescriptionFunction
						poster = await posterFunc()
					} else {
						poster = this.value as BlPosterDescription
					}
					
					// 转换为海报绘制配置
					this.result = this.posterDescriptionToPalette(poster)
				} catch (e) {
					const error = e as PosterError
					this.error = error instanceof Error ? error : new Error(error.message || '未知错误')
					const errorMessage = this.error.message || '海报生成失败'
					uni.showToast({
						icon: 'none',
						title: `海报生成失败: ${errorMessage}`
					})
				} finally {
					this.loading = false
				}
			},
			posterDescriptionToPalette(poster: BlPosterDescription): PosterPalette {
				// 这里需要根据 BlPosterPainter 的格式转换
				// 简化实现，实际需要完整的转换逻辑
				return {
					width: '290px',
					height: '430px',
					borderRadius: '12px',
					background: poster.background || 'var(--bl-primary-color)',
					views: []
				}
			},
			handleImageReady(img: string): void {
				this.$emit('imageReady', img)
			},
			handleError(err: PosterError): void {
				const errorMessage = err instanceof Error ? err.message : (err.message || '未知错误')
				console.error('海报生成失败', errorMessage)
				this.$emit('imageError', err)
			}
		}
	}
</script>

<style lang="scss">
	/* 引入组件样式 */
	@import './index.scss';
</style>

