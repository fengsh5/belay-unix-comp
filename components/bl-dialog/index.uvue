<template>
	<bl-modal
		:visible="visible"
		:overlay-closable="overlayClosable"
		:content-style="contentStyle"
		@close="handleClose"
		@click-overlay="handleClickOverlay"
	>
		<text v-if="title != null && title != ''" :class="titleClass" :style="titleStyle">{{ title }}</text>
		<bl-icon 
			v-if="showCloseIcon" 
			icon="close" 
			class="bl-dialog__close"
			@click="handleCancel"
		></bl-icon>
		<view :class="contentClass" :style="messageStyle">
			<slot>{{ message }}</slot>
		</view>
		<view v-if="footer != null" class="bl-dialog__footer">
			<slot name="footer">{{ footer }}</slot>
		</view>
		<view v-else-if="showCancelButton || showConfirmButton" :class="footerClass">
			<bl-hairline v-if="theme !== 'round-button'" placement="['top']"></bl-hairline>
			<bl-button
				v-if="showCancelButton"
				:class="cancelClass"
				:text="cancelText"
				:round="theme === 'round-button'"
				:plain="theme !== 'round-button'"
				@click="handleCancel"
			></bl-button>
			<bl-hairline v-if="theme !== 'round-button' && showCancelButton && showConfirmButton" placement="['right']"></bl-hairline>
			<bl-button
				v-if="showConfirmButton"
				:class="confirmClass"
				type="primary"
				:text="confirmText"
				:round="theme === 'round-button'"
				:plain="theme !== 'round-button'"
				:disabled="loading"
				@click="handleConfirm"
			></bl-button>
		</view>
	</bl-modal>
</template>

<script lang="uts">
	import { t } from '../../utils/BlI18n/index.uts'
	
	export enum DialogAction {
		cancel = 'cancel',
		confirm = 'confirm'
	}
	
	export default {
		name: 'BlDialog',
		props: {
			/**
			 * 是否显示
			 */
			visible: {
				type: Boolean,
				default: false
			},
			/**
			 * 弹窗容器宽度
			 */
			width: {
				type: [Number, String],
				default: '327px'
			},
			/**
			 * 标题
			 */
			title: {
				type: String,
				default: ''
			},
			/**
			 * 标题样式
			 */
			titleStyle: {
				type: String,
				default: ''
			},
			/**
			 * 内容
			 */
			message: {
				type: String,
				default: ''
			},
			/**
			 * 内容样式
			 */
			messageStyle: {
				type: String,
				default: ''
			},
			/**
			 * 按钮主题
			 */
			theme: {
				type: String,
				default: 'default' // default | round-button
			},
			/**
			 * 是否显示关闭图标
			 */
			showCloseIcon: {
				type: Boolean,
				default: false
			},
			/**
			 * 是否显示取消按钮
			 */
			showCancelButton: {
				type: Boolean,
				default: false
			},
			/**
			 * 是否显示确认按钮
			 */
			showConfirmButton: {
				type: Boolean,
				default: true
			},
			/**
			 * 底部显示区域
			 */
			footer: {
				type: String,
				default: null
			},
			/**
			 * 底部确认按钮内容
			 */
			confirmText: {
				type: String,
				default: ''
			},
			/**
			 * 底部取消按钮内容
			 */
			cancelText: {
				type: String,
				default: ''
			},
			/**
			 * 点击遮罩层是否可关闭
			 */
			overlayClosable: {
				type: Boolean,
				default: false
			},
			/**
			 * 自定义样式
			 */
			customStyle: {
				type: String,
				default: ''
			}
		},
		data() {
			return {
				loading: false
			}
		},
		emits: ['close', 'cancel', 'confirm', 'clickOverlay', 'beforeClose'],
		computed: {
			contentStyle(): string {
				const styles: string[] = []
				const widthValue = typeof this.width === 'number' ? `${this.width}px` : this.width as string
				styles.push(`width: ${widthValue}`)
				styles.push('border-radius: 16px')
				if (this.customStyle != '') {
					styles.push(this.customStyle)
				}
				return styles.join('; ')
			},
			titleClass(): string {
				return 'bl-dialog__title'
			},
			contentClass(): string {
				const classes: string[] = ['bl-dialog__content']
				if (this.title != null && this.title != '') {
					classes.push('bl-dialog__content--has-title')
				}
				return classes.join(' ')
			},
			footerClass(): string {
				const classes: string[] = ['bl-dialog__footer']
				if (this.theme === 'round-button') {
					classes.push('bl-dialog__footer--actions')
				}
				return classes.join(' ')
			},
			cancelClass(): string {
				const classes: string[] = ['bl-dialog__cancel']
				if (this.theme === 'round-button') {
					classes.push('bl-dialog__cancel--round')
				}
				return classes.join(' ')
			},
			confirmClass(): string {
				const classes: string[] = ['bl-dialog__confirm']
				if (this.theme === 'round-button') {
					classes.push('bl-dialog__confirm--round')
				}
				return classes.join(' ')
			},
			confirmTextValue(): string {
				return this.confirmText != null && this.confirmText != '' ? this.confirmText : t('comp.confirm')
			},
			cancelTextValue(): string {
				return this.cancelText != null && this.cancelText != '' ? this.cancelText : t('comp.cancel')
			}
		},
		methods: {
			async handleAction(action: DialogAction, callback: () => void): Promise<void> {
				try {
					await callback()
					
					// 处理 beforeClose
					const beforeClose = this.$attrs.onBeforeClose
					if (beforeClose != null && typeof beforeClose === 'function') {
						this.loading = true
						beforeClose(
							action,
							() => {
								this.$emit('close', action)
								this.loading = false
							},
							() => {
								this.loading = false
							}
						)
					} else {
						this.$emit('close', action)
					}
				} catch (error) {
					console.error('[BlDialog] handleAction error:', error)
				}
			},
			handleCancel(): void {
				this.handleAction(DialogAction.cancel, () => {
					this.$emit('cancel')
					return Promise.resolve()
				})
			},
			handleConfirm(): void {
				this.handleAction(DialogAction.confirm, () => {
					this.$emit('confirm')
					return Promise.resolve()
				})
			},
			handleClose(): void {
				this.$emit('close', DialogAction.cancel)
			},
			handleClickOverlay(): void {
				this.$emit('clickOverlay')
			}
	}
}
</script>

<style lang="scss">
	/* 引入组件样式 */
	@import './index.scss';
</style>
