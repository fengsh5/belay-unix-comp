<template>
	<view 
		:class="iconClass"
		:style="iconStyle"
		@click="handleClick"
	>
		<!-- 如果是 uni-app 内置图标类型，使用 icon 组件 -->
		<icon 
			v-if="isUniIconType"
			:type="iconType"
			:size="iconSize"
			:color="iconColor"
		></icon>
		<!-- 如果是 HTTP 图片或 data URI，使用 image 组件 -->
		<image 
			v-else-if="isImageUrl"
			:src="iconSource"
			:style="imageStyle"
			mode="aspectFit"
		></image>
		<!-- 如果是 SVG 字符串，转换为 data URI 后使用 image 组件 -->
		<image 
			v-else-if="isSvgString"
			:src="svgDataUri"
			:style="imageStyle"
			mode="aspectFit"
		></image>
	</view>
</template>

<script lang="uts">
	/**
	 * SVG 图标染色
	 */
	function svgDye(svg: string, color: string): string {
		const fillRegexp = /fill=["'][^"']+["']/gi
		const matched = svg.match(fillRegexp)
		if (matched) {
			const uniqueMatches = new Set(matched)
			if (uniqueMatches.size > 1) {
				// 多色图标，不处理
				return svg
			} else {
				return svg.replace(fillRegexp, () => `fill="${color}"`)
			}
		}
		return svg
	}
	
	/**
	 * 判断是否为有效 URL
	 */
	function isValidUrl(url: string): boolean {
		return url.startsWith('http') || url.startsWith('data:') || url.startsWith('.') || url.startsWith('/')
	}
	
	/**
	 * 将 SVG 转换为 data URI
	 */
	function transformSvg(svg: string, color: string): string {
		const dyedSvg = svgDye(svg, color)
		return `data:image/svg+xml,${encodeURIComponent(dyedSvg)}`
	}
	
	export default {
		name: 'BlIcon',
		props: {
			/**
			 * 自定义样式
			 */
			customStyle: {
				type: String,
				default: ''
			},
			/**
			 * 支持绑定 内置图标名称、http 图片、或 svg 字符串
			 */
			icon: {
				type: String,
				default: ''
			},
			/**
			 * 图标宽度
			 */
			width: {
				type: [Number, String],
				default: '1em'
			},
			/**
			 * 对于多色 SVG 图标和 HTTP 图标无效
			 */
			color: {
				type: String,
				default: ''
			}
		},
		emits: ['click'],
		computed: {
			iconClass(): string {
				const classes: string[] = ['bl-icon']
				if (this.icon == 'loading') {
					classes.push('bl-icon--loading')
				}
				return classes.join(' ')
			},
			iconStyle(): string {
				const styles: string[] = []
				if (this.customStyle != '') {
					styles.push(this.customStyle)
				}
				return styles.join('; ')
			},
			/**
			 * 判断是否是 uni-app 内置图标类型
			 */
			isUniIconType(): boolean {
				if (!this.icon) {
					return false
				}
				// uni-app 内置图标类型
				const uniIconTypes = [
					'success', 'success_no_circle', 'info', 'warn', 'waiting', 
					'cancel', 'download', 'search', 'clear', 'loading'
				]
				return uniIconTypes.includes(this.icon)
			},
			/**
			 * uni-app icon 组件的 type 属性
			 */
			iconType(): string {
				return this.icon
			},
			/**
			 * uni-app icon 组件的 size 属性（像素值）
			 */
			iconSize(): number {
				if (typeof this.width == 'number') {
					return this.width
				}
				// 如果是字符串，尝试解析
				if (typeof this.width == 'string') {
					const match = this.width.match(/(\d+)/)
					if (match != null) {
						return Number.parseInt(match[1])
					}
				}
				// 默认 26px（uni-app icon 的默认大小）
				return 26
			},
			/**
			 * uni-app icon 组件的 color 属性
			 */
			iconColor(): string {
				return this.color != null && this.color != '' ? this.color : '#333333'
			},
			/**
			 * 判断是否是图片 URL
			 */
			isImageUrl(): boolean {
				if (!this.icon) {
					return false
				}
				return isValidUrl(this.icon) && !this.icon.includes('<svg')
			},
			/**
			 * 判断是否是 SVG 字符串
			 */
			isSvgString(): boolean {
				if (!this.icon) {
					return false
				}
				return this.icon.includes('<svg')
			},
			/**
			 * 图标源（用于 image 组件）
			 */
			iconSource(): string {
				return this.icon
			},
			/**
			 * SVG 转换后的 data URI
			 */
			svgDataUri(): string {
				if (!this.icon || !this.isSvgString) {
					return ''
				}
				const colorValue = this.color != null && this.color != '' 
					? this.color 
					: 'var(--bl-gray-5)'
				return transformSvg(this.icon, colorValue)
			},
			/**
			 * image 组件的样式
			 */
			imageStyle(): string {
				const styles: string[] = []
				const size = typeof this.width == 'number' 
					? `${this.width}px` 
					: (this.width as string)
				styles.push(`width: ${size}`)
				styles.push(`height: ${size}`)
				return styles.join('; ')
			}
		},
		methods: {
			handleClick(): void {
				this.$emit('click')
			}
	}
}
</script>

<style lang="scss">
	/* 引入组件样式 */
	@import './index.scss';
</style>
