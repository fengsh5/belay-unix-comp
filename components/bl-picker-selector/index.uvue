<template>
	<picker
		:class="pickerClass"
		:style="pickerStyle"
		mode="selector"
		:value="selectedIndex"
		:range="range"
		:range-key="rangeKey"
		:disabled="disabled"
		@change="handleChange"
		@cancel="handleCancel"
	>
		<slot>
			<view class="bl-pickerselector__trigger">
				<text class="bl-pickerselector__text">{{ displayText }}</text>
				<bl-icon v-if="showArrow" name="arrow-down" class="bl-pickerselector__arrow"></bl-icon>
			</view>
		</slot>
	</picker>
</template>

<script lang="uts">
	// 选择器项类型
	type PickerItem = string | number | {
		[key: string]: string | number | boolean | null | undefined
	}

	// 选择器事件类型
	type PickerChangeEvent = {
		detail?: {
			value?: number
		}
		[key: string]: number | string | boolean | null | undefined
	}

	// 选择器变化结果类型
	type PickerChangeResult = {
		value: string | number | null
		index: number
		item: PickerItem
	}

	export default {
		name: 'BlPickerSelector',
		props: {
			/**
			 * 当前选中的值
			 */
			value: {
				type: [String, Number],
				default: null
			},
			/**
			 * 选项数组
			 */
			range: {
				type: Array,
				default: () => []
			},
			/**
			 * 当 range 是一个 Object Array 时，通过 range-key 来指定 Object 中 key 的值作为选择器显示内容
			 */
			rangeKey: {
				type: String,
				default: ''
			},
			/**
			 * 是否禁用
			 */
			disabled: {
				type: Boolean,
				default: false
			},
			/**
			 * 占位符
			 */
			placeholder: {
				type: String,
				default: '请选择'
			},
			/**
			 * 是否显示箭头
			 */
			showArrow: {
				type: Boolean,
				default: true
			},
			/**
			 * 显示文本格式化函数
			 */
			formatter: {
				type: Function,
				default: null
			},
			/**
			 * 自定义样式
			 */
			customStyle: {
				type: String,
				default: ''
			},
			/**
			 * 自定义类名
			 */
			customClass: {
				type: String,
				default: ''
			}
		},
		emits: ['change', 'cancel'],
		computed: {
			pickerClass(): string {
				const classes: string[] = ['bl-pickerselector']
				if (this.disabled) {
					classes.push('bl-pickerselector--disabled')
				}
				if (this.customClass != '') {
					classes.push(this.customClass)
				}
				return classes.join(' ')
			},
			pickerStyle(): string {
				const styles: string[] = []
				if (this.customStyle != '') {
					styles.push(this.customStyle)
				}
				return styles.join('; ')
			},
			selectedIndex(): number {
				if (this.value == null) {
					return 0
				}
				// 查找值在range中的索引
				const rangeArray = this.range as PickerItem[]
				for (let i = 0; i < rangeArray.length; i++) {
					const item = rangeArray[i]
					if (this.rangeKey != '' && typeof item == 'object' && item != null) {
						const itemObj = item as { [key: string]: string | number | boolean | null | undefined }
						if (itemObj[this.rangeKey] == this.value) {
							return i
						}
					} else if (item == this.value) {
						return i
					}
				}
				return 0
			},
			displayText(): string {
				const rangeArray = this.range as PickerItem[]
				if (this.selectedIndex < 0 || this.selectedIndex >= rangeArray.length) {
					return this.placeholder
				}
				const selectedItem = rangeArray[this.selectedIndex]
				let text = ''
				
				if (this.rangeKey != '' && typeof selectedItem == 'object' && selectedItem != null) {
					const itemObj = selectedItem as { [key: string]: string | number | boolean | null | undefined }
					text = String(itemObj[this.rangeKey] || '')
				} else {
					text = String(selectedItem || '')
				}
				
				if (this.formatter != null && typeof this.formatter == 'function') {
					return this.formatter(text, selectedItem, this.selectedIndex)
				}
				return text || this.placeholder
			}
		},
		methods: {
			handleChange(e: PickerChangeEvent): void {
				const index = e.detail?.value || 0
				const rangeArray = this.range as PickerItem[]
				const selectedItem = rangeArray[index]
				let value: string | number | null = null
				
				if (this.rangeKey != '' && typeof selectedItem == 'object' && selectedItem != null) {
					const itemObj = selectedItem as { [key: string]: string | number | boolean | null | undefined }
					const keyValue = itemObj[this.rangeKey]
					if (typeof keyValue == 'string' || typeof keyValue == 'number') {
						value = keyValue
					}
				} else if (selectedItem != null) {
					if (typeof selectedItem == 'string' || typeof selectedItem == 'number') {
					value = selectedItem
					}
				}
				
				const result: PickerChangeResult = {
					value: value,
					index: index,
					item: selectedItem
				}
				this.$emit('change', result)
			},
			handleCancel(e: PickerChangeEvent): void {
				this.$emit('cancel', e)
			}
	}
}
</script>

<style lang="scss">
	/* 引入组件样式 */
	@import './index.scss';
</style>
