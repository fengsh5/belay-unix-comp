/**
 * 主题切换工具（参考 Ant Design 的 ConfigProvider 方案）
 * 
 * 使用方式：
 * 
 * // 方式一：通过组件属性传递主题配置
 * <bl-theme-provider :theme="themeConfig">
 *   <your-content />
 * </bl-theme-provider>
 * 
 * // 方式二：通过全局配置方法动态切换主题
 * import { BlTheme } from '@/uni_modules/belay-unix/utils/BlTheme/index.uts'
 * 
 * BlTheme.config({
 *   theme: {
 *     'primary-color': '#409eff',
 *     'background-color': '#ffffff',
 *     // ... 其他主题变量
 *   }
 * })
 */

// 主题配置类型（对应 SCSS 变量文件中的主题定义）
export type ThemeConfig = {
	// 主色调
	'primary-color'?: string
	'primary-color-1'?: string
	'primary-color-2'?: string
	'primary-color-3'?: string
	'primary-color-4'?: string
	'secondary-color'?: string
	
	// 功能色
	'success-color'?: string
	'success-color-1'?: string
	'success-color-2'?: string
	'success-color-3'?: string
	'success-color-4'?: string
	
	'error-color'?: string
	'error-color-1'?: string
	'error-color-2'?: string
	'error-color-3'?: string
	'error-color-4'?: string
	
	'warning-color'?: string
	'warning-color-1'?: string
	'warning-color-2'?: string
	'warning-color-3'?: string
	'warning-color-4'?: string
	
	'info-color'?: string
	'info-color-1'?: string
	'info-color-2'?: string
	'info-color-3'?: string
	'info-color-4'?: string
	
	// 基础色
	'black-color'?: string
	'white-color'?: string
	
	// 灰度颜色
	'gray-1'?: string
	'gray-2'?: string
	'gray-3'?: string
	'gray-4'?: string
	'gray-5'?: string
	'gray-6'?: string
	
	// 背景色
	'background-color'?: string
	'background-color-secondary'?: string
	
	// 文字颜色
	'text-color'?: string
	'text-color-secondary'?: string
	'text-color-disabled'?: string
	
	// 边框颜色
	'border-color'?: string
	'border-color-light'?: string
	'border-color-lighter'?: string
	'border-color-extra-light'?: string
	
	// 圆角
	'border-radius'?: string
	'border-radius-small'?: string
	'border-radius-large'?: string
	'border-radius-round'?: string
	'border-radius-circle'?: string
	
	// 间距
	'spacing-xs'?: string
	'spacing-sm'?: string
	'spacing-md'?: string
	'spacing-lg'?: string
	'spacing-xl'?: string
	
	// 字体大小
	'font-size-xs'?: string
	'font-size-sm'?: string
	'font-size-base'?: string
	'font-size-lg'?: string
	'font-size-xl'?: string
	
	// 行高
	'line-height-base'?: string
	'line-height-sm'?: string
	'line-height-lg'?: string
	
	// z-index
	'z-index-base'?: string
	'z-index-dropdown'?: string
	'z-index-sticky'?: string
	'z-index-fixed'?: string
	'z-index-modal'?: string
	'z-index-tooltip'?: string
}

// 主题配置选项类型
export type ThemeConfigOptions = {
	theme?: ThemeConfig
}

