// 当前全局主题配置
let globalThemeConfig: ThemeConfig = {}

// 主题变更监听器
type ThemeChangeListener = (theme: ThemeConfig) => void
const themeChangeListeners: ThemeChangeListener[] = []

/**
 * BlTheme 类（参考 Ant Design 的 ConfigProvider）
 * 提供全局主题配置和切换功能
 */
export class BlTheme {
	/**
	 * 配置主题（类似 antd 的 ConfigProvider.config）
	 * @param options 主题配置选项
	 */
	static config(options: ThemeConfigOptions): void {
		if (options.theme != null) {
			// 合并主题配置（只更新提供的属性）
			for (const key in options.theme) {
				const value = options.theme[key as keyof ThemeConfig]
				if (value != null) {
					globalThemeConfig[key as keyof ThemeConfig] = value
				}
			}
			
			// 应用主题到 CSS 变量
			applyThemeToCSS(globalThemeConfig)
			
			// 通知所有监听器
			themeChangeListeners.forEach(listener => {
				listener(globalThemeConfig)
			})
			
			// 保存到本地存储
			try {
				uni.setStorageSync('bl-theme-config', globalThemeConfig)
			} catch (e) {
				console.error('[BlTheme] 保存主题配置失败', e)
			}
		}
	}
	
	/**
	 * 获取当前主题配置
	 */
	static getTheme(): ThemeConfig {
		return { ...globalThemeConfig }
	}
	
	/**
	 * 重置主题为默认值
	 * @param themeName 主题名称（'light' | 'dark'），默认为 'light'
	 */
	static resetTheme(themeName: 'light' | 'dark' = 'light'): void {
		const defaultTheme = themeName === 'light' ? defaultLightTheme : defaultDarkTheme
		globalThemeConfig = { ...defaultTheme }
		this.config({ theme: globalThemeConfig })
	}
	
	/**
	 * 设置预设主题（浅色或深色）
	 * @param themeName 主题名称（'light' | 'dark'）
	 */
	static setPresetTheme(themeName: 'light' | 'dark'): void {
		const presetTheme = themeName === 'light' ? defaultLightTheme : defaultDarkTheme
		globalThemeConfig = { ...presetTheme }
		this.config({ theme: globalThemeConfig })
	}
	
	/**
	 * 添加主题变更监听器
	 * @param listener 监听器函数
	 */
	static onThemeChange(listener: ThemeChangeListener): void {
		themeChangeListeners.push(listener)
	}
	
	/**
	 * 移除主题变更监听器
	 * @param listener 监听器函数
	 */
	static offThemeChange(listener: ThemeChangeListener): void {
		const index = themeChangeListeners.indexOf(listener)
		if (index >= 0) {
			themeChangeListeners.splice(index, 1)
		}
	}
	
	/**
	 * 初始化主题（从本地存储读取）
	 */
	static initTheme(): void {
		try {
			const savedConfig = uni.getStorageSync('bl-theme-config')
			if (savedConfig != null && typeof savedConfig == 'object') {
				globalThemeConfig = savedConfig as ThemeConfig
				applyThemeToCSS(globalThemeConfig)
			} else {
				// 如果没有保存的配置，使用默认浅色主题
				this.resetTheme('light')
			}
		} catch (e) {
			console.error('[BlTheme] 读取主题配置失败', e)
			// 读取失败时使用默认浅色主题
			this.resetTheme('light')
		}
	}
}

/**
 * 应用主题到 CSS 变量
 * 在 uni-app x 中，通过设置页面根元素的样式来实现主题切换
 * @param theme 主题配置对象
 */
function applyThemeToCSS(theme: ThemeConfig): void {
	// 在 H5 平台，直接设置 document 的 CSS 变量
	// #ifdef H5
	try {
		if (typeof document != 'undefined' && document.documentElement != null) {
			// 设置 CSS 变量
			for (const key in theme) {
				const value = theme[key as keyof ThemeConfig]
				if (value != null) {
					// 将主题变量名转换为 CSS 变量名（添加 --bl- 前缀）
					const cssVarName = `--bl-${key}`
					document.documentElement.style.setProperty(cssVarName, value)
				}
			}
		}
	} catch (e) {
		console.error('[BlTheme] 应用主题到 CSS 失败', e)
	}
	// #endif
	
	// 在 APP 和小程序平台，主题切换通过 BlThemeProvider 组件的内联样式实现
	// BlThemeProvider 会生成 CSS 变量，子组件通过 var(--bl-xxx) 使用
	// #ifdef APP || MP
	// 注意：在 APP 和小程序中，无法直接操作 document.documentElement
	// 因此需要通过 BlThemeProvider 组件的内联样式来设置 CSS 变量
	// BlThemeProvider 组件会自动处理主题切换
	// #endif
}

/**
 * 获取主题变量的 CSS 变量名
 * @param key 主题变量键名
 * @returns CSS 变量名（如 '--bl-primary-color'）
 */
export function getThemeCSSVar(key: keyof ThemeConfig): string {
	return `--bl-${key}`
}

/**
 * 获取主题变量的值
 * @param key 主题变量键名
 * @param theme 主题配置对象，如果不提供则使用全局主题配置
 * @returns 主题变量的值
 */
export function getThemeValue(key: keyof ThemeConfig, theme?: ThemeConfig | null): string | null {
	const config = theme || globalThemeConfig
	if (config == null) {
		return null
	}
	const value = config[key]
	return value != null ? value : null
}

/**
 * 合并主题配置（深度合并）
 * @param base 基础主题配置
 * @param override 要覆盖的主题配置
 * @returns 合并后的主题配置
 */
export function mergeThemeConfig(base: ThemeConfig, override: ThemeConfig): ThemeConfig {
	const result: ThemeConfig = { ...base }
	for (const key in override) {
		const value = override[key as keyof ThemeConfig]
		if (value != null) {
			result[key as keyof ThemeConfig] = value
		}
	}
	return result
}

/**
 * 获取默认主题配置
 * @param themeName 主题名称（'light' | 'dark'），默认为 'light'
 * @returns 默认主题配置
 */
export function getDefaultTheme(themeName: 'light' | 'dark' = 'light'): ThemeConfig {
	return themeName === 'light' ? { ...defaultLightTheme } : { ...defaultDarkTheme }
}

// 导出默认主题配置（供组件使用）
export { defaultLightTheme, defaultDarkTheme }
