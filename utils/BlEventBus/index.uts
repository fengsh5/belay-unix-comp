/**
 * 事件总线工具类
 * 用于组件间通信
 */

/**
 * 事件处理器类型
 */
type EventHandler = (data?: any) => void

/**
 * 事件总线类
 */
export class EventBus {
	private events: Map<string, EventHandler[]> = new Map()

	/**
	 * 监听事件
	 * @param event 事件名称
	 * @param handler 事件处理函数
	 */
	on(event: string, handler: EventHandler): void {
		const handlers = this.events.get(event) || []
		handlers.push(handler)
		this.events.set(event, handlers)
	}

	/**
	 * 取消监听事件
	 * @param event 事件名称
	 * @param handler 事件处理函数（可选，如果不提供则移除该事件的所有监听器）
	 */
	off(event: string, handler?: EventHandler): void {
		if (handler == null) {
			// 移除该事件的所有监听器
			this.events.delete(event)
			return
		}

		const handlers = this.events.get(event)
		if (handlers != null) {
			const index = handlers.indexOf(handler)
			if (index >= 0) {
				handlers.splice(index, 1)
				if (handlers.length == 0) {
					this.events.delete(event)
				} else {
					this.events.set(event, handlers)
				}
			}
		}
	}

	/**
	 * 触发事件
	 * @param event 事件名称
	 * @param data 事件数据（可选）
	 */
	emit(event: string, data?: any): void {
		const handlers = this.events.get(event)
		if (handlers != null) {
			// 复制数组，避免在执行过程中修改原数组
			const handlersCopy = handlers.slice()
			for (let i = 0; i < handlersCopy.length; i++) {
				try {
					handlersCopy[i](data)
				} catch (error) {
					console.error(`[EventBus] 事件 "${event}" 的处理函数执行出错:`, error)
				}
			}
		}
	}

	/**
	 * 移除所有监听器
	 */
	clear(): void {
		this.events.clear()
	}

	/**
	 * 获取指定事件的监听器数量
	 * @param event 事件名称（可选，如果不提供则返回所有事件的数量）
	 */
	listenerCount(event?: string): number {
		if (event != null) {
			const handlers = this.events.get(event)
			return handlers != null ? handlers.length : 0
		}

		// 返回所有事件的监听器总数
		let count = 0
		this.events.forEach((handlers) => {
			count += handlers.length
		})
		return count
	}

	/**
	 * 获取所有事件名称
	 */
	eventNames(): string[] {
		return Array.from(this.events.keys())
	}
}

/**
 * 全局事件总线实例
 * 可以在任何地方使用，用于跨组件、跨页面通信
 */
export const globalEventBus = new EventBus()

